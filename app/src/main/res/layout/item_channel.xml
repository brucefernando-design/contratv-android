<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_card_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/ivChannelLogo"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:contentDescription="Logo del Canal"
        android:scaleType="fitCenter"
        android:src="@drawable/logo_contratv" />

    <TextView
        android:id="@+id/tvChannelNum"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/brand_cyan"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvChannelName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:text="Nombre del Canal"
        android:textColor="@color/text_primary"
        android:textSize="12sp" />
</LinearLayout>
