<resources>
    <!-- Base theme -->
    <style name="Theme.ContraTV" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_blue</item>
        <item name="colorPrimaryVariant">@color/brand_blue_dark</item>
        <item name="colorSecondary">@color/brand_cyan</item>
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.ContraTV.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.ContraTV.Player" parent="Theme.ContraTV.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:keepScreenOn">true</item>
    </style>
</resources>
